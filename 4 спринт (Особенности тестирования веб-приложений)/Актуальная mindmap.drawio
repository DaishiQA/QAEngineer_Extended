        <mxCell id="whmJ6EjX5ACkZhL5BFrf-78" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=9;align=center;fontColor=#FF0000;strokeColor=#FF0000;verticalAlign=middle;" value="&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;font&gt;&lt;font&gt;В требованиях в разделе&lt;/font&gt;&lt;font&gt;&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;«&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font&gt;Окно &quot;Введите код из&lt;/font&gt;&lt;font&gt; &lt;u&gt;&lt;b&gt;СМС&lt;/b&gt;&lt;/u&gt;&lt;/font&gt;&lt;font&gt;&quot;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;» в наименовании окна в текстовой части слово &quot;СМС&quot; написано заглавными буквами, а на графическом изображении и в макетах - строчными. Необходимо устранить противоречие.&lt;/span&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="50" width="280" x="280" y="640" as="geometry" />
        </mxCell>
        <mxCell id="whmJ6EjX5ACkZhL5BFrf-79" parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;strokeWidth=3;strokeColor=#FF0000;" value="&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;4&lt;/font&gt;" vertex="1">
          <mxGeometry height="16.5" width="16.5" x="890" y="585" as="geometry" />
        </mxCell>
        <mxCell id="whmJ6EjX5ACkZhL5BFrf-85" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=9;align=center;fontColor=#FF0000;strokeColor=#FF0000;" value="&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;font style=&quot;&quot;&gt;В требованиях в разделе&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;«&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;Окно &quot;Введите код из СМС&quot;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;» в текстовой части указана кнопка&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font&gt;&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;font&gt;«Отправить код ещё раз&lt;/font&gt;&lt;font style=&quot;&quot;&gt; &lt;u&gt;&lt;b&gt;через&lt;/b&gt;&lt;/u&gt;&lt;/font&gt;&lt;/font&gt; &lt;/font&gt;&lt;font style=&quot;&quot;&gt;00:60 &lt;/font&gt;&lt;font style=&quot;&quot;&gt;&lt;b&gt;&lt;u&gt;секунд&lt;/u&gt;&lt;/b&gt;&lt;/font&gt;&lt;font style=&quot;&quot;&gt;»,&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;font style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font&gt;а на графическом изображении и в макетах -&lt;/font&gt;&lt;font&gt;&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;font&gt;&lt;font&gt;«Отправить код ещё раз 00:23»&lt;/font&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;. Таким образом, на графическом изображении и в макетах отсутствуют слова &quot;через&quot; и &quot;секунд&quot;.&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;/font&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;Необходимо устранить противоречие.&lt;/font&gt;&lt;/span&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
