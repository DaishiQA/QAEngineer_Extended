          <mxGeometry height="94.94" width="97.5" x="-2017.5" y="14.120000000000001" as="geometry" />
        </mxCell>
        <mxCell id="OWGDl912cK5O2wD1rpTl-96" parent="1" style="text;whiteSpace=wrap;html=1;fontSize=8;fontColor=#00994D;align=center;verticalAlign=middle;" value="&lt;u&gt;Действие&lt;/u&gt;: нажать кнопку &quot;Забронировать&quot;&lt;div&gt;&lt;u&gt;Событие&lt;/u&gt;:&amp;nbsp;&lt;span style=&quot;background-color: transparent;&quot;&gt;вместо панели с названиями режимов появится форма бронирования&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; text-align: left;&quot;&gt;(по умолчанию выбран тариф &quot;Повседневный&quot;, выпадающий список панели &quot;Требования к заказу&quot; свернут,&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; text-align: left;&quot;&gt;поля &quot;Добавить права&quot; и &quot;Способ оплаты&quot; не заполнены&lt;/span&gt;&lt;/div&gt;" vertex="1">
