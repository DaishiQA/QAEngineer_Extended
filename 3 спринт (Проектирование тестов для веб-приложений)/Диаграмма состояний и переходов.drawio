        <mxCell id="ZFOXHSzJh7PvanMTgfww-11" parent="1" style="text;whiteSpace=wrap;html=1;fontColor=#FF0000;fontSize=8;align=center;verticalAlign=middle;" value="&lt;font&gt;&lt;u&gt;&lt;b&gt;Действие:&lt;/b&gt;&lt;/u&gt; Нажать кнопку &quot;Добавить права&quot;&lt;/font&gt;&lt;div&gt;&lt;font&gt;&lt;u style=&quot;&quot;&gt;&lt;b style=&quot;&quot;&gt;Событие:&lt;/b&gt;&lt;/u&gt;&amp;nbsp;&lt;span style=&quot;&quot;&gt;Над формой — текст сообщения: «Ваши документы не прошли верификацию. Попробуйте ещё раз»&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;font-family: monospace; font-size: 0px; text-wrap-mode: nowrap; background-color: transparent;&quot;&gt;%3E%3CmxCell%20id%3D%220%22%2F%3E%3CmxCell%20id%3D%221%22%20parent%3D%220%22%2F%3E%3CmxCell%20id%3D%222%22%20parent%3D%221%22%20style%3D%22text%3BwhiteSpace%3Dwrap%3Bhtml%3D1%3BfontColor%3D%2300994D%3BfontSize%3D8%3Balign%3Dcenter%3BverticalAlign%3Dmiddle%3B%22%20value%3D%22%26lt%3Bfont%26gt%3B%26lt%3Bu%26gt%3B%26lt%3Bb%26gt%3B%D0%94%D0%B5%D0%B9%D1%81%D1%82%D0%B2%D0%B8%D0%B5%3A%26lt%3B%2Fb%26gt%3B%26lt%3B%2Fu%26gt%3B%20%D0%9D%D0%B0%D0%B6%D0%B0%D1%82%D1%8C%20%D0%BA%D0%BD%D0%BE%D0%BF%D0%BA%D1%83%20%26quot%3B%D0%94%D0%BE%D0%B1%D0%B0%D0%B2%D0%B8%D1%82%D1%8C%20%D0%BF%D1%80%D0%B0%D0%B2%D0%B0%26quot%3B%26lt%3B%2Ffont%26gt%3B%22%20vertex%3D%221%22%3E%3CmxGeometry%20height%3D%2220%22%20width%3D%22100%22%20x%3D%22875%22%20y%3D%2270%22%20as%3D%22geometry%22%2F%3E%3C%2FmxCell%3E%3C%2Froot%3E%3C%2FmxGraphModel%3E&lt;/span&gt;&lt;/div&gt;" vertex="1">
